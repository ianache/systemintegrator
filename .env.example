# Copy to .env only when you need non-sensitive local overrides.
MYSQL_DATABASE=integration
MYSQL_PORT=3306
REDIS_PORT=6379
KAFKA_PORT=29092
GATEWAY_PORT=8081

# Compose uses the safe `local` Gateway profile unless this is overridden at runtime.
# Set SPRING_PROFILES_ACTIVE=qa-e2e together with an authorized issuer only for QA E2E.
# Optional: set only for an issuer you are authorized to use.
# KEYCLOAK_ISSUER_URI=https://issuer.example.test/realms/integration
