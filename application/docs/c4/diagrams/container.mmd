    eng -->|"JDBC"| extdb
    eng -->|"HTTP"| extapi

    classDef focus stroke:#B71C1C,stroke-width:4px,fill:#ffffff,color:#212121;
    classDef other stroke:#616161,stroke-width:2px,fill:#ffffff,color:#212121;
