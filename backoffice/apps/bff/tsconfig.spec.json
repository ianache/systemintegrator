{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "bundler",
    // Lets ts-jest transpile the ESM-only openid-client dependency chain
    // (see transformIgnorePatterns in jest.config.cts) down to CommonJS.
    "allowJs": true,
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
